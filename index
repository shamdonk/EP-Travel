<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Travel Wellness Checklist</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-color: #0b0f19;
      --card-bg: #151c2c;
      --card-hover: #1e293b;
      --accent-green: #10b981;
      --accent-blue: #38bdf8;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #334155;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Inter', sans-serif;
      line-height: 1.5;
      padding: 2rem 1rem 4rem;
    }

    .container {
      max-width: 620px;
      margin: 0 auto;
    }

    /* ── HEADER ── */
    header { margin-bottom: 2rem; }

    .subtitle {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 0.4rem;
    }

    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 2.25rem;
      font-weight: 600;
      line-height: 1.2;
      margin-bottom: 0.4rem;
    }

    .meta-info {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1.25rem;
    }

    /* ── OVERALL PROGRESS ── */
    .progress-container { margin-bottom: 0.5rem; }

    .progress-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
    }

    .progress-count { color: var(--text-muted); }
    .progress-percentage { color: var(--accent-green); font-weight: 600; }

    .progress-bar-bg {
      background-color: var(--border-color);
      height: 6px;
      border-radius: 3px;
      overflow: hidden;
    }

    .progress-bar-fill {
      background: linear-gradient(90deg, var(--accent-green), var(--accent-blue));
      height: 100%;
      width: 0%;
      transition: width 0.35s ease;
    }

    /* ── RESET BUTTON ── */
    .reset-btn {
      display: block;
      margin-top: 0.85rem;
      background: none;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.4rem 0.9rem;
      border-radius: 4px;
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
    }
    .reset-btn:hover { color: var(--text-main); border-color: var(--text-muted); }

    /* ── SECTION HEADER ── */
    .section-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin: 2.25rem 0 0.9rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.5rem;
    }

    .section-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.2rem;
      font-style: italic;
    }

    /* colored dot per category */
    .section-title::before {
      content: '';
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 0.55rem;
      vertical-align: middle;
      position: relative;
      top: -1px;
    }
    .section-hydration .section-title::before { background: var(--accent-blue); }
    .section-movement  .section-title::before { background: var(--accent-green); }
    .section-nutrition .section-title::before { background: var(--accent-amber); }

    .section-tally {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-style: normal;
      font-family: 'Inter', sans-serif;
    }
    .section-tally span { color: var(--accent-green); font-weight: 600; }

    /* ── EXERCISE CARD ── */
    .exercise-card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      margin-bottom: 0.65rem;
      overflow: hidden;
      transition: background-color 0.2s, border-color 0.2s;
    }
    .exercise-card:hover { background-color: var(--card-hover); }

    /* dim card when checked */
    .exercise-card.checked {
      opacity: 0.55;
    }

    .exercise-main-row {
      display: flex;
      align-items: center;
      padding: 0.9rem 1rem;
      cursor: pointer;
      gap: 0.75rem;
    }

    /* ── CUSTOM CHECKBOX ── */
    .checkbox-container {
      position: relative;
      width: 22px;
      height: 22px;
      flex-shrink: 0;
    }
    .checkbox-container input {
      position: absolute;
      opacity: 0;
      cursor: pointer;
      height: 0;
      width: 0;
    }
    .custom-checkmark {
      position: absolute;
      inset: 0;
      border: 2px solid var(--border-color);
      border-radius: 4px;
      transition: all 0.2s;
    }
    .checkbox-container input:checked ~ .custom-checkmark {
      background-color: var(--accent-green);
      border-color: var(--accent-green);
    }
    .custom-checkmark::after {
      content: '';
      position: absolute;
      display: none;
      left: 6px; top: 2px;
      width: 5px; height: 10px;
      border: solid white;
      border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }
    .checkbox-container input:checked ~ .custom-checkmark::after { display: block; }

    /* ── TEXT ── */
    .exercise-info { flex-grow: 1; }
    .exercise-name { font-weight: 500; font-size: 0.975rem; }
    .exercise-notes { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.1rem; }

    /* category badge */
    .exercise-badge {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
      flex-shrink: 0;
    }
    .badge-hydration { background: rgba(56,189,248,0.12); color: var(--accent-blue); }
    .badge-movement  { background: rgba(16,185,129,0.12); color: var(--accent-green); }
    .badge-nutrition { background: rgba(245,158,11,0.12); color: var(--accent-amber); }

    /* ── TIP TOGGLE BUTTON ── */
    .tip-toggle-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.7rem;
      padding: 0.5rem;
      transition: transform 0.3s, color 0.2s;
      line-height: 1;
    }
    .tip-toggle-btn:hover { color: var(--text-main); }
    .exercise-card.tip-open .tip-toggle-btn {
      transform: rotate(90deg);
      color: var(--accent-green);
    }

    /* ── TIP DROPDOWN ── */
    .tip-dropdown {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }
    .exercise-card.tip-open .tip-dropdown {
      max-height: 400px;
      border-top: 1px solid var(--border-color);
    }

    .tip-content {
      padding: 0.85rem 1rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    .tip-content strong {
      display: block;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--accent-green);
      margin-bottom: 0.3rem;
    }

    /* ── YOUTUBE THUMBNAIL ── */
    .video-thumb {
      padding: 0.75rem 1rem;
    }
    .video-thumb a {
      display: block;
      position: relative;
      border-radius: 6px;
      overflow: hidden;
    }
    .video-thumb img {
      width: 100%;
      display: block;
    }
    .video-play-label {
      position: absolute;
      bottom: 8px;
      left: 8px;
      background: rgba(0,0,0,0.75);
      color: #fff;
      font-size: 11px;
      padding: 4px 10px;
      border-radius: 4px;
    }

    /* ── COMPLETION BANNER ── */
    .completion-banner {
      display: none;
      margin-top: 2rem;
      background: rgba(16,185,129,0.1);
      border: 1px solid rgba(16,185,129,0.3);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      text-align: center;
    }
    .completion-banner.show { display: block; }
    .completion-banner h2 {
      font-family: 'Playfair Display', serif;
      font-size: 1.3rem;
      margin-bottom: 0.3rem;
      color: var(--accent-green);
    }
    .completion-banner p { font-size: 0.85rem; color: var(--text-muted); }
  </style>
</head>
<body>
<div class="container">

  <!-- HEADER -->
  <header>
    <div class="subtitle">Travel Wellness Protocol</div>
    <h1>Hydration, Movement &amp; Nutrition</h1>
    <div class="meta-info">10 items &nbsp;·&nbsp; Pre-flight, In-flight &amp; On arrival</div>

    <div class="progress-container">
      <div class="progress-labels">
        <span class="progress-count" id="progress-text">0 of 18 complete</span>
        <span class="progress-percentage" id="progress-percent">0%</span>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progress-fill"></div>
      </div>
    </div>

    <button class="reset-btn" onclick="resetAll()">↺ Reset checklist</button>
  </header>

  <!-- ═══════════ HYDRATION ═══════════ -->
  <div class="section-hydration">
    <div class="section-header">
      <div class="section-title">Hydration</div>
      <div class="section-tally"><span id="hydration-done">0</span> / 1 done</div>
    </div>

    <!-- H6 -->
    <div class="exercise-card" data-section="hydration">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Rehydrate on arrival</div>
          <div class="exercise-notes">20 oz + electrolytes within 30 min of landing</div>
        </div>
        <span class="exercise-badge badge-hydration">Arrival</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          Even with in-flight hydration, most people arrive mildly dehydrated. A deliberate 20 oz rehydration window before meals, alcohol, or intense activity helps reset your system and reduces post-travel fatigue significantly.
        </div>
      </div>
    </div>
  </div>

  <!-- ═══════════ MOVEMENT ═══════════ -->
  <div class="section-movement">
    <div class="section-header">
      <div class="section-title">Golf Warm Up / Mobility</div>
      <div class="section-tally"><span id="movement-done">0</span> / 3 done</div>
    </div>

    <!-- M2 -->
    <div class="exercise-card" data-section="movement">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Cat Camel</div>
          <div class="exercise-notes">Slow spinal segmentation</div>
        </div>
        <span class="exercise-badge badge-movement">2 sets · 6</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="video-thumb">
          <a href="https://youtu.be/zvQ_EaBDZoM" target="_blank">
            <img src="https://img.youtube.com/vi/zvQ_EaBDZoM/hqdefault.jpg" alt="Cat Camel">
            <span class="video-play-label">► Tap to watch on YouTube</span>
          </a>
        </div>
      </div>
    </div>

    <!-- M3 -->
    <div class="exercise-card" data-section="movement">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">T-Spine Rotation</div>
          <div class="exercise-notes">Focus on ribcage rotation</div>
        </div>
        <span class="exercise-badge badge-movement">2 sets · 8</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="video-thumb">
          <a href="https://youtu.be/pqDGrbYgTAc" target="_blank">
            <img src="https://img.youtube.com/vi/pqDGrbYgTAc/hqdefault.jpg" alt="T-Spine Rotation">
            <span class="video-play-label">► Tap to watch on YouTube</span>
          </a>
        </div>
      </div>
    </div>

    <!-- M4 -->
    <div class="exercise-card" data-section="movement">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Hip Flexor #1</div>
          <div class="exercise-notes">Keep pelvis tucked under</div>
        </div>
        <span class="exercise-badge badge-movement">1 set · :60</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="video-thumb">
          <a href="https://youtu.be/KTztUw-N5xQ" target="_blank">
            <img src="https://img.youtube.com/vi/KTztUw-N5xQ/hqdefault.jpg" alt="Hip Flexor #1">
            <span class="video-play-label">► Tap to watch on YouTube</span>
          </a>
        </div>
      </div>
    </div>

  </div>

  <!-- ═══════════ NUTRITION ═══════════ -->
  <div class="section-nutrition">
    <div class="section-header">
      <div class="section-title">Nutrition</div>
      <div class="section-tally"><span id="nutrition-done">0</span> / 6 done</div>
    </div>

    <!-- N1 -->
    <div class="exercise-card" data-section="nutrition">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Eat a real meal before departure</div>
          <div class="exercise-notes">Don't rely on airports — fuel up beforehand</div>
        </div>
        <span class="exercise-badge badge-nutrition">Pre-flight</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          Airport food is overpriced, often high in sodium, and nutritionally thin. A balanced meal with protein, healthy fat, and complex carbs before you leave stabilizes blood sugar for hours and prevents the tired/irritable cycle that derails travel days.
        </div>
      </div>
    </div>

    <!-- N2 -->
    <div class="exercise-card" data-section="nutrition">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Pack high-protein snacks</div>
          <div class="exercise-notes">Jerky, mixed nuts, protein bars, hard-boiled eggs</div>
        </div>
        <span class="exercise-badge badge-nutrition">Pre-flight</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          Protein is the most satiating macronutrient — it keeps hunger at bay longer than carbs or fat alone. Having a reliable snack in your bag means you're never forced to choose between bad airport food and being hungry. Aim for 15–20g protein per snack.
        </div>
      </div>
    </div>

    <!-- N3 -->
    <div class="exercise-card" data-section="nutrition">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Avoid heavy, fried, or gassy foods</div>
          <div class="exercise-notes">Beans, cruciferous veg, carbonated drinks — skip day of</div>
        </div>
        <span class="exercise-badge badge-nutrition">Pre-flight</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          Cabin pressure is lower than at sea level — gases in your gut expand by 25–30% at altitude. Foods that cause bloating on the ground cause significantly more discomfort in the air. Light, easily digestible meals make the flight far more comfortable.
        </div>
      </div>
    </div>

    <!-- N4 -->
    <div class="exercise-card" data-section="nutrition">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Take travel supplements</div>
          <div class="exercise-notes">Vitamin D, magnesium glycinate, zinc — with food</div>
        </div>
        <span class="exercise-badge badge-nutrition">In-flight</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          Travel suppresses immune function through stress, sleep disruption, and exposure to crowded spaces. Vitamin D supports immunity and mood; magnesium glycinate aids sleep quality and muscle relaxation; zinc helps defend against respiratory viruses. Take with a small snack to avoid nausea.
        </div>
      </div>
    </div>

    <!-- N5 -->
    <div class="exercise-card" data-section="nutrition">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">Eat light mid-flight</div>
          <div class="exercise-notes">Small portions — digestion slows significantly at altitude</div>
        </div>
        <span class="exercise-badge badge-nutrition">In-flight</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          Reduced oxygen and pressure impair digestive efficiency. Heavy meals in-flight often lead to bloating, lethargy, and poor sleep. If the airline serves food, opt for lighter options — salads, proteins, fruit — and eat until satisfied, not full.
        </div>
      </div>
    </div>

    <!-- N6 -->
    <div class="exercise-card" data-section="nutrition">
      <div class="exercise-main-row" onclick="toggleTip(this, event)">
        <label class="checkbox-container" onclick="event.stopPropagation()">
          <input type="checkbox" class="exercise-checkbox" onchange="updateProgress()">
          <span class="custom-checkmark"></span>
        </label>
        <div class="exercise-info">
          <div class="exercise-name">First meal at destination — prioritize protein</div>
          <div class="exercise-notes">30–40g protein within 2 hrs of landing</div>
        </div>
        <span class="exercise-badge badge-nutrition">Arrival</span>
        <button class="tip-toggle-btn">►</button>
      </div>
      <div class="tip-dropdown">
        <div class="tip-content">
          <strong>Why it matters</strong>
          A protein-rich first meal after landing helps muscle protein synthesis, stabilizes blood sugar after a day of irregular eating, and — combined with your walk in natural light — sends a strong signal to your body that it's time to re-anchor to the new local schedule.
        </div>
      </div>
    </div>
  </div>

  <!-- COMPLETION BANNER -->
  <div class="completion-banner" id="completion-banner">
    <h2>Checklist Complete ✓</h2>
    <p>You've covered all 10 items. Travel well.</p>
  </div>

</div>

<!-- JAVASCRIPT -->
<script>
  const TOTAL = 10;

  function toggleTip(rowEl, event) {
    const card = rowEl.parentElement;
    card.classList.toggle('tip-open');
  }

  function updateProgress() {
    const allBoxes = document.querySelectorAll('.exercise-checkbox');
    let completed = 0;
    allBoxes.forEach(cb => {
      const card = cb.closest('.exercise-card');
      if (cb.checked) { completed++; card.classList.add('checked'); }
      else { card.classList.remove('checked'); }
    });

    const pct = Math.round((completed / TOTAL) * 100);
    document.getElementById('progress-text').textContent = `${completed} of 10 complete`;
    document.getElementById('progress-percent').textContent = `${pct}%`;
    document.getElementById('progress-fill').style.width = `${pct}%`;

    // per-section tallies
    ['hydration', 'movement', 'nutrition'].forEach(section => {
      const boxes = document.querySelectorAll(`[data-section="${section}"] .exercise-checkbox`);
      let done = 0;
      boxes.forEach(cb => { if (cb.checked) done++; });
      document.getElementById(`${section}-done`).textContent = done;
    });

    // completion banner
    document.getElementById('completion-banner').classList.toggle('show', completed === TOTAL);
  }

  function resetAll() {
    document.querySelectorAll('.exercise-checkbox').forEach(cb => {
      cb.checked = false;
      cb.closest('.exercise-card').classList.remove('checked', 'tip-open');
    });
    updateProgress();
  }
</script>
</body>
</html>
